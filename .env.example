# ===========================================================================
# RAYANE AFFAIRE — environment variables
# ===========================================================================
# Copy to `.env.local` (never commit it). `.env.local` is git-ignored.
# Values marked REQUIRED must be set before a production deploy.
# ===========================================================================

# --- Business contact (public, shown in the UI) ----------------------------
# WhatsApp: digits only, international format, no "+" and no spaces.
# Example: 213550123456
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phone shown in the header/footer. Example: +213 550 12 34 56
NEXT_PUBLIC_PHONE_NUMBER=

# Public contact e-mail. Example: contact@rayane-affaire.dz
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional postal address. Leave empty to hide the address block entirely
# (the UI omits it rather than showing a placeholder).
NEXT_PUBLIC_OFFICE_ADDRESS=

# Optional social profiles — each renders only when set.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Site -----------------------------------------------------------------
# Canonical public URL, used by sitemap, robots and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional hero photograph (a real agency photo). Falls back to branded artwork.
# Prefer a LOCAL path under public/ (e.g. /images/hero-bejaia.jpg): the Content
# Security Policy only allows images from a fixed set of hosts, so an absolute
# URL to an unlisted domain is blocked by the browser. Allowed hosts today:
# self, images.unsplash.com, upload.wikimedia.org, *.tile.openstreetmap.org —
# see middleware.ts (img-src) and next.config.mjs (images.remotePatterns).
NEXT_PUBLIC_HERO_IMAGE=

# --- Server-only secrets (NEVER expose) -----------------------------------
# REQUIRED in production, minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Storage --------------------------------------------------------------
# SQLite file path. Defaults to ./data/rayane.db
DATABASE_PATH=
